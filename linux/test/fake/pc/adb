#!/usr/bin/env bash
# заглушка adb для test_pc_install.sh: телефон - это каталог $FAKE_ST, все вызовы пишутся в $FAKE_ST/log
# FAKE_DL - уровень отладки (getprop), FAKE_CMDL - он же в /proc/cmdline, FAKE_REBOOT_WORKS=0 - reboot не меняет уровень,
# FAKE_INSTALLED=1 - Debian уже стоит (partial - распакован, но настройка не закончена), FAKE_BADSHA=1 - sha256 копии
# EFS на телефоне другой (FAKE_EFS_CUT=1 - поток exec-out оборвался), FAKE_BRC - код backup_efs.sh, FAKE_NOBACKUP=1 - backup_efs.sh не создал архив, FAKE_MSIZE -
# размер модели на телефоне, $FAKE_ST/unlock - сколько раз телефон ещё заблокирован, FAKE_NOROOT=1 - su не дал root,
# FAKE_STATE=1 - get-state с ошибкой (FAKE_DEVICES - сколько устройств в adb devices, FAKE_DEVSTATE - состояние
# единственного: unauthorized, offline...; FAKE_DEVICES_FAIL=1 - adb devices с ошибкой), FAKE_INSTALL_RC - код установки (install-bg + install-log:
# FAKE_INSTALL_DEAD=1 - она оборвалась, FAKE_INSTALL_DROP=N - после install-bg N опросов телефона нет, FAKE_INSTALL_BG_RC -
# код install-bg, FAKE_INSTALL_RUNNING=1 - установка уже идёт с прошлого запуска), FAKE_CONF_BL - строка BATT_LIMIT=N
# в debian.conf, FAKE_NPU_TAR_RC - код распаковки пакета NPU; push копирует файлы в $FAKE_ST/pushed.
# Перезагрузка (reboot debug0x4f4c): ещё FAKE_SLOW вызовов телефон работает по-старому (выключается), FAKE_DOWN вызовов
# его нет в adb, потом новая загрузка - другой boot_id, уровень 0x4f4c (FAKE_REBOOT_WORKS=0 - прежний).
# FAKE_NOREBOOT=1 - reboot не срабатывает. FAKE_NPU_RC - код npu.sh test (3 - DSP не открылся), FAKE_NPU_REBOOT=1 -
# npu.sh test перезагружает телефон (как сбой DSP/ядра), FAKE_NPU_FLAP=N - после npu.sh test N вызовов телефона нет в adb,
# но он не перезагружался. FAKE_ADB_VER=N - adb version 1.0.N (по умолчанию 41). FAKE_CHECK_FAIL=1 - check_phone.sh
# оборвался без ИТОГ. Magisk: FAKE_NOSU=1 - su нет (boot без Magisk), FAKE_NOAPP=1 - приложения Magisk нет (root не даётся,
# пока не поставят Magisk*.apk), FAKE_ROOT_AFTER=N - первые N запросов su отклоняются (пользователь ещё не разрешил),
# FAKE_CONF_X11 - строка AUTO_X11=N в debian.conf, FAKE_X11_RC - код debian.sh x11. FAKE_NOENV=1 - не сделана «доп. настройка» (нет /data/adb/magisk/busybox), её делает открытие Magisk + перезагрузка.
# FAKE_NOX11APP=1 - Termux:X11 не установлен. FAKE_SSH_RC - код debian.sh ssh key. Копия Debian: exec-out ... debian.sh backup - отдаёт маленький tar.gz
# (FAKE_BACKUP_RC - код backup, FAKE_BACKUP_BROKEN=1 - поток оборвался), FAKE_RESTORE_RC - код debian.sh restore,
# FAKE_FREE_KB - свободно на /data (df -k), FAKE_CONF_USER - DEB_USER в debian.conf, FAKE_BACKUP_HANG=1 - поток встал.
S=$FAKE_ST; echo "ADB $*" >>"$S/log"
dl() { cat "$S/dl" 2>/dev/null || echo "${FAKE_DL-0x4f4c}"; }
left() { local N; N=$(cat "$S/$1" 2>/dev/null || echo 0); [ "$N" -gt 0 ] || return 1; echo $((N - 1)) >"$S/$1"; }
if left flap; then # связь пропала, телефон не перезагружался
  [ "$1" = devices ] && { echo "List of devices attached"; exit 0; }
  echo "adb: no devices/emulators found" >&2; exit 1
fi
if [ -f "$S/newdl" ] && ! left slow; then
  if left down; then
    [ "$1" = devices ] && { echo "List of devices attached"; exit 0; }
    echo "adb: no devices/emulators found" >&2; exit 1
  fi
  mv "$S/newdl" "$S/dl"; echo $(($(cat "$S/boot" 2>/dev/null || echo 1) + 1)) >"$S/boot"; echo BOOTED >>"$S/log"
  [ -f "$S/newenv" ] && mv "$S/newenv" "$S/env"
fi
case "$1" in
  version) echo "Android Debug Bridge version 1.0.${FAKE_ADB_VER:-41}"; echo "Version 35.0.2-12147458"; exit 0 ;;
  get-state) [ "${FAKE_STATE:-0}" = 1 ] && { echo "error: no devices/emulators found" >&2; exit 1; }; echo device; exit 0 ;;
  devices) [ "${FAKE_DEVICES_FAIL:-0}" = 1 ] && { echo "* failed to start daemon" >&2; exit 1; }
    echo "List of devices attached"; [ -n "${FAKE_DEVSTATE:-}" ] && { printf 'R5CN0000\t%s\n' "$FAKE_DEVSTATE"; exit 0; }; I=0
    while [ "$I" -lt "${FAKE_DEVICES:-1}" ]; do printf 'R5CN%04d\tdevice\n' "$I"; I=$((I + 1)); done; exit 0 ;;
  push) mkdir -p "$S/pushed"; shift; while [ $# -gt 1 ]; do cp "$1" "$S/pushed/"; shift; done; exit 0 ;;
  install) case "$*" in *Magisk*.apk) cmp -s "${*: -1}" "$FAKE_SRV/Magisk-v31.1.apk" || exit 1; : >"$S/app" ;; esac; exit 0 ;;
  pull) echo "BAD PULL $2" >>"$S/log"; exit 1 ;; # копия EFS - только через exec-out su cat
  shell) ;;
  exec-out) case "${*:2}" in
      "su -mm -c 'cat /data/local/fold2-efs/fold2-efs-"*) [ "${FAKE_EFS_CUT:-0}" = 1 ] && { head -c 10 "$S/efs.tgz"; exit 0; }; cat "$S/efs.tgz" ;;
      *"debian.sh backup -"*) echo "${FAKE_BACKUP_RC:-0}" >"$S/backup.rc"; [ "${FAKE_BACKUP_RC:-0}" = 0 ] || exit 0
        [ "${FAKE_BACKUP_HANG:-0}" = 1 ] && { head -c 100 /dev/zero; exec /bin/sleep 61; }
        D=$(mktemp -d); mkdir -p "$D/debian/etc"; echo "root:x:0:0::/root:/bin/bash" >"$D/debian/etc/passwd"; echo "DEB_USER=fold2" >"$D/debian.conf"
        case "${*:2}" in *"backup - models "*) mkdir -p "$D/debian/var/lib/llama"; head -c 4096 /dev/urandom >"$D/debian/var/lib/llama/m.gguf" ;; esac
        if [ "${FAKE_BACKUP_BROKEN:-0}" = 1 ]; then tar -czf - -C "$D" debian debian.conf | head -c 60; else tar -czf - -C "$D" debian debian.conf; fi
        rm -rf "$D" ;;
    esac; exit 0 ;;
  *) echo "неизвестная команда adb $1" >>"$S/log"; exit 1 ;;
esac
C="${*:2}"
case "$C" in
  "su -mm -c 'id'"|"su -c id")
    [ -n "${FAKE_ROOT_AFTER:-}" ] && [ ! -f "$S/rootwait" ] && echo "$FAKE_ROOT_AFTER" >"$S/rootwait"
    if [ "${FAKE_NOROOT:-0}" = 1 ] || [ "${FAKE_NOSU:-0}" = 1 ] || { [ "${FAKE_NOAPP:-0}" = 1 ] && [ ! -f "$S/app" ]; } || left rootwait; then
      echo "Permission denied"; exit 1
    fi
    echo "uid=0(root) gid=0(root)" ;;
  "su -v 2>/dev/null") [ "${FAKE_NOSU:-0}" = 1 ] && exit 127; echo "31.1:MAGISK:R" ;;
  "pm list packages com.topjohnwu.magisk") { [ "${FAKE_NOAPP:-0}" = 1 ] && [ ! -f "$S/app" ]; } || echo "package:com.topjohnwu.magisk" ;;
  "monkey -p com.topjohnwu.magisk"*) echo MAGISK_OPENED >>"$S/log"
    # приложение делает «доп. настройку» и перезагружает телефон
    if [ "${FAKE_NOENV:-0}" = 1 ] && [ ! -f "$S/env" ] && [ ! -f "$S/newenv" ]; then : >"$S/newenv"; dl >"$S/newdl"; echo 0 >"$S/slow"; echo 2 >"$S/down"; fi ;;
  *"test -x /data/adb/magisk/busybox && echo yes"*) { [ "${FAKE_NOENV:-0}" = 1 ] && [ ! -f "$S/env" ]; } || echo yes ;;
  *check_phone.sh*) [ "${FAKE_CHECK_FAIL:-0}" = 1 ] && { echo "check_phone.sh[12]: syntax error"; exit 1; }
    printf '%s\r\n' "fold2: проверка телефона 2026-11-01 12:00, root: да" "ИТОГ: OK 20, ВНИМАНИЕ 1, НЕТ 0" \
      "OK        модем: F916BXXS7KXH1" "ВНИМАНИЕ  SIM: ABSENT,ABSENT (не вставлена или не видна)" "" "ПОДРОБНОСТИ" "--- связь" ;;
  *"random/boot_id"*) printf '%08d-1111-2222-3333-444455556666\n' "$(cat "$S/boot" 2>/dev/null || echo 1)" ;;
  *backup_efs.sh*) echo "[fold2-efs]   efs: 100 байт"
    [ "${FAKE_NOBACKUP:-0}" = 1 ] || echo "[fold2-efs] готово: /data/local/fold2-efs/fold2-efs-20261101-120000.tar.gz (1 разделов)"
    exit "${FAKE_BRC:-0}" ;;
  *"sha256sum /data/local/fold2-efs/fold2-efs"*) if [ "${FAKE_BADSHA:-0}" = 1 ]; then echo "deadbeef  x"; else sha256sum "$S/efs.tgz"; fi ;;
  "getprop ro.boot.debug_level") dl ;;
  "getprop sys.boot_completed") echo 1 ;;
  "getprop "*) echo "fake-${C#getprop }" ;;
  *"cat /proc/cmdline"*) echo "a=b androidboot.debug_level=${FAKE_CMDL-$(dl)} c=d" ;;
  *"reboot debug0x4f4c"*) echo REBOOTED >>"$S/log"; [ "${FAKE_NOREBOOT:-0}" = 1 ] && exit 1
    if [ "${FAKE_REBOOT_WORKS:-1}" = 1 ]; then echo 0x4f4c; else dl; fi >"$S/newdl"
    echo "${FAKE_SLOW:-0}" >"$S/slow"; echo "${FAKE_DOWN:-2}" >"$S/down" ;;
  "test -d /sdcard/Android") N=$(cat "$S/unlock" 2>/dev/null || echo 0)
    [ "$N" -gt 0 ] && { echo $((N - 1)) >"$S/unlock"; exit 1; }; exit 0 ;;
  *"fold2-setup.done && echo yes"*) [ "${FAKE_INSTALLED:-0}" = 1 ] && echo yes; exit 0 ;;
  *"debian/bin/sh && test -f "*"setup_in_chroot.sh && echo yes"*) [ "${FAKE_INSTALLED:-0}" != 0 ] && echo yes; exit 0 ;;
  *"test -x /data/local/fold2/debian/bin/sh && echo yes"*|*"test -e /data/local/fold2/debian && echo yes"*)
    [ "${FAKE_INSTALLED:-0}" != 0 ] && echo yes; exit 0 ;;
  *"debian.conf && echo yes"*) echo yes ;;
  *"cat /data/local/tmp/fold2/backup.rc"*) cat "$S/backup.rc" 2>/dev/null || exit 1 ;;
  *"cat /data/local/tmp/fold2/backup.log"*) if [ "${FAKE_BACKUP_RC:-0}" = 0 ]; then echo "[fold2] копия готова"
    else echo "[fold2] ОШИБКА: не копирую: Debian не остановился"; fi ;;
  *"debian.sh restore /data/local/tmp/fold2/debian-restore.tar.gz"*) echo "[fold2] распаковка копии ... (минуты)"
    [ "${FAKE_RESTORE_RC:-0}" = 0 ] && echo "[fold2] Debian восстановлен" || echo "[fold2] ОШИБКА: распаковка не удалась"; exit "${FAKE_RESTORE_RC:-0}" ;;
  *"grep ^DEB_USER= "*) [ -n "${FAKE_CONF_USER:-}" ] || exit 1; echo "DEB_USER=$FAKE_CONF_USER" ;;
  *"df -k /data"*) echo "Filesystem 1K-blocks Used Available Use% Mounted on"; echo "/dev/block/dm-5 230000000 30000000 ${FAKE_FREE_KB:-200000000} 13% /data" ;;
  "pm path com.termux.x11") [ "${FAKE_NOX11APP:-0}" = 1 ] || echo "package:/data/app/~~x/com.termux.x11-1/base.apk" ;;
  *"grep ^BATT_LIMIT= "*) [ -n "${FAKE_CONF_BL:-}" ] || exit 1; echo "$FAKE_CONF_BL" ;;
  *"grep ^AUTO_X11= "*) [ -n "${FAKE_CONF_X11:-}" ] || exit 1; echo "$FAKE_CONF_X11" ;;
  *"debian.sh x11"*) [ "${FAKE_X11_RC:-0}" = 0 ] && echo "[fold2] XFCE запущен" || echo "[fold2] ОШИБКА: X-сервер Termux:X11 не поднялся"; exit "${FAKE_X11_RC:-0}" ;;
  "stat -c %s /sdcard/models/"*) if [ -n "${FAKE_MSIZE:-}" ]; then echo "$FAKE_MSIZE"; else echo "stat: No such file" >&2; exit 1; fi ;;
  *"sha256sum -c -s && /data/adb/magisk/busybox tar -xJf /data/local/fold2-npu.tar.xz"*) exit "${FAKE_NPU_TAR_RC:-0}" ;;
  *"npu.sh test"*) echo "[fold2-npu] f2q-bench 2048 2048"
    # сбой DSP перезагрузил телефон: связь рвётся, FAKE_DOWN вызовов его нет, потом новая загрузка с тем же уровнем
    [ -n "${FAKE_NPU_FLAP:-}" ] && echo "$FAKE_NPU_FLAP" >"$S/flap"
    if [ "${FAKE_NPU_REBOOT:-0}" = 1 ]; then dl >"$S/newdl"; echo 0 >"$S/slow"; echo "${FAKE_DOWN:-2}" >"$S/down"; exit 255; fi
    case "${FAKE_NPU_RC:-0}" in 0|3) echo "ИТОГ: OK" ;; *) echo "ИТОГ: FAIL" ;; esac; exit "${FAKE_NPU_RC:-0}" ;;
  *"debian.sh ssh key "*) exit "${FAKE_SSH_RC:-0}" ;;
  *"debian.sh status"*) echo "rootfs: есть"; echo "батарея: 80%" ;;
  *"debian.sh install-log "*) # install.log растёт за 2 опроса: опрос 1 - 2 строки и run, опрос 2 - 3 строки и код
    N=${C##*install-log }; N=${N%%[!0-9]*}
    if [ "$N" = 999999999 ]; then # состояние до установки
      if [ "${FAKE_INSTALL_RUNNING:-0}" = 1 ] && [ ! -f "$S/idone" ]; then echo "@@fold2 1 run"; else echo "@@fold2 0 dead"; fi; exit 0
    fi
    left idrop && { echo "adb: device offline" >&2; exit 1; }
    P=$(($(cat "$S/ipoll" 2>/dev/null || echo 0) + 1)); echo "$P" >"$S/ipoll"
    L1="[fold2] распаковка rootfs"; L2="[fold2] apt-get install"; L3="[fold2] готово."
    [ "${FAKE_INSTALL_RC:-0}" = 0 ] || L3="E: Unable to fetch some archives"
    if [ "$P" -lt 2 ]; then ST=run; ALL=$(printf '%s\n%s' "$L1" "$L2"); L=2
    else ST=${FAKE_INSTALL_RC:-0}; [ "${FAKE_INSTALL_DEAD:-0}" = 1 ] && ST=dead; ALL=$(printf '%s\n%s\n%s' "$L1" "$L2" "$L3"); L=3; : >"$S/idone"; fi
    [ "$N" -lt "$L" ] && printf '%s\n' "$ALL" | sed -n "$((N + 1)),\$p"
    echo "@@fold2 $L $ST" ;;
  *"debian.sh install-bg "*) echo "[fold2] установка идёт отдельно от adb (pid 4242)"
    [ -n "${FAKE_INSTALL_DROP:-}" ] && echo "$FAKE_INSTALL_DROP" >"$S/idrop"; exit "${FAKE_INSTALL_BG_RC:-0}" ;;
  *"debian.sh install"*) echo "[fold2] установка..."; [ "${FAKE_INSTALL_RC:-0}" = 0 ] || echo "E: Unable to fetch some archives"
    exit "${FAKE_INSTALL_RC:-0}" ;;
  *"tail -n 80 /data/local/fold2/install.log"*) echo "E: Unable to fetch some archives" ;;
  *"uname -a"*) echo "Linux localhost 4.19.325" ;;
  *"getenforce; magisk -c"*) echo Enforcing; echo "31.1:MAGISK:R (31100)"; echo "/dev/block/dm-5  220G  20G  200G  10% /data" ;;
  *"debian.sh bootlog ls"*) echo "20261101-100000-1a2b3c4d: KP" ;;
  *"ip -4 addr show wlan0"*) echo "    inet 192.168.1.5/24 brd 192.168.1.255 scope global wlan0" ;;
esac
exit 0
