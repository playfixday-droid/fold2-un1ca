// f2qdsp: quantized matmul (Q4_0/Q8_0 weights x Q8 activations) on cDSP Hexagon 698 (HVX v66) for llama.cpp
#include "AEEStdDef.idl"
#include "remote.idl"

interface f2qdsp : remote_handle64 {
   // text info about the DSP side (version, threads, HVX)
   long info(rout sequence<octet> text);
   // DSP clock vote: 0 - release, 1 - max performance
   long power(in long level);
   // y[t][r] = sum_k W[r][k] * x[t][k] for tiles of 32 rows.
   // w: weight tiles (see f2q_format.h), x: activations (n rows of xstride bytes), y: float, n rows of ystride floats
   long mm(in sequence<octet> w, in sequence<octet> x, rout sequence<octet> y,
           in long wtype, in long tiles, in long k, in long n, in long xstride, in long ystride, in long nthreads);
   // mm with weights at an offset (method added in v2.1, after mm - old ARM code keeps working with a new skel):
   //   wa != 0 - weights are mapped into this PD at DSP address wa (remote_mmap64), wsz bytes, w is empty;
   //   wa == 0 - weights are w (any registered buffer, e.g. the whole weight buffer of the model).
   // Tiles start at byte woff. flags: 1 - persistent DSP worker threads instead of new threads per call.
   // dsp_us: time spent inside this method on the DSP (microseconds) - the rest of the call is FastRPC.
   long mm2(in sequence<octet> w, in long wa, in long wsz, in long woff, in sequence<octet> x, rout sequence<octet> y,
            in long wtype, in long tiles, in long k, in long n, in long xstride, in long ystride, in long nthreads,
            in long flags, rout long dsp_us);
   // mailbox (method added after mm2): the DSP stays in this call and takes jobs from shared memory io
   // (control block f2q_mbox.h + activations + results; weights by DSP address from remote_mmap64).
   // Returns after idle_ms milliseconds without jobs or on the exit command.
   long serve(inrout sequence<octet> io, in long idle_ms);
};
