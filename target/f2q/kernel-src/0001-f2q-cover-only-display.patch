diff --git a/techpack/display/msm/dsi/dsi_display.c b/techpack/display/msm/dsi/dsi_display.c
index 542a7ee..b3dc9fd 100644
--- a/techpack/display/msm/dsi/dsi_display.c
+++ b/techpack/display/msm/dsi/dsi_display.c
@@ -5592,6 +5592,22 @@ static void dsi_display_firmware_display(const struct firmware *fw,
 	DSI_DEBUG("success\n");
 }
 
+/*
+ * fold2-kit: Galaxy Z Fold2 with a dead inner panel.
+ * msm_drm.f2q_cover_only=1: the inner (DSI0, "primary") display still probes
+ * and binds exactly like stock (msm_drm needs every DSI component), but its
+ * DRM connector is reported as disconnected and the cover panel (DSI1) is
+ * advertised to the composer as "primary". Default off = stock behaviour.
+ */
+static bool f2q_cover_only;
+module_param(f2q_cover_only, bool, 0444);
+MODULE_PARM_DESC(f2q_cover_only, "Hide the inner panel, use the cover panel as primary");
+
+bool dsi_display_f2q_cover_only(void)
+{
+	return f2q_cover_only;
+}
+
 int dsi_display_dev_probe(struct platform_device *pdev)
 {
 	struct dsi_display *display = NULL;
diff --git a/techpack/display/msm/dsi/dsi_display.h b/techpack/display/msm/dsi/dsi_display.h
