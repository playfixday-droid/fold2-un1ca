# Фрагмент ядра f2q: железо стокового F916B, которого нет в f2q.config UN1CA (kernel_samsung_sm8250, sixteen).
# Добавляется после f2q.config. Сверено со стоковым ядром F916BXXS7KXH1 (IKCONFIG из boot.img), 2026-11-04.
#
# Вибромотор Cirrus CS40L25: в DT Fold2 (dtbo) - "cirrus,cs40l25a", у стока драйвер cs40l2x
# (/sys/class/timed_output/vibrator). Набор опций - как в c2q.config того же дерева (Note20 Ultra).
# MOTOR_DRV_CS40L2X зависит от ANDROID_TIMED_OUTPUT. AIDL HAL вибрации (a52q, patches/blobs) умеет timed_output.
CONFIG_ANDROID_TIMED_OUTPUT=y
CONFIG_MOTOR_DRV_CS40L2X=y
CONFIG_MOTOR_DRV_CS40L2X_PMIC_RESET=y
CONFIG_CS40L2X_SAMSUNG_FEATURE=y
# Как в стоке: квоты CPU для cgroup (docker run --cpus)
CONFIG_CFS_BANDWIDTH=y
# USB-хаб/док (8 в 1): быстрый режим UAS для USB-SSD (usb-storage уже есть; exFAT - sdfat, сеть RTL8152/AX88179 есть)
CONFIG_USB_UAS=y
# Как в стоке: perf_event_paranoid=3 по умолчанию (kernel-src/0004). Требует матрица совместимости Android (VINTF),
# без опции Android показывает «Внутренняя ошибка устройства. Обратитесь к производителю».
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
