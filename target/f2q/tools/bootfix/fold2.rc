# Fold2 (f2q) UN1CA: помощник загрузки. Magisk (overlay.d в ramdisk boot) дописывает этот файл к init.rc,
# ${MAGISKTMP} - его tmpfs, куда скопирован overlay.d/sbin/fold2boot.sh. Без Magisk (BOOT_noroot) не работает.
# post-fs идёт до late-fs (mount_all --late = монтирование и шифрование /data); /cache и /metadata уже смонтированы.
on post-fs
    exec u:r:magisk:s0 root root -- /system/bin/sh ${MAGISKTMP}/fold2boot.sh fix
    start fold2_log

service fold2_log /system/bin/sh ${MAGISKTMP}/fold2boot.sh log
    user root
    group root
    seclabel u:r:magisk:s0
    priority 10
    ioprio be 7
    oneshot
    disabled
